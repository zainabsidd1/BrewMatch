# Local FastAPI. Production values live in the Render dashboard.
DATABASE_URL=postgresql://brewmatch:brewmatch@localhost:5432/brewmatch
JWT_SECRET_KEY=dev-only-change-this-in-production
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=12
